{
	"manifestVersion": 1,
	"name": "db",
	"title": "Database",
	"description": "Documents with live queries and SQL tables with typed columns - one Durable Object per collection or table.",
	"packageName": "@frostbase-dev/db",
	"worker": "db-agent",
	"durableObjects": [
		{ "class": "DbAgent", "scope": "perProject" },
		{ "class": "DbCollection", "scope": "perCollection" },
		{ "class": "DbTable", "scope": "perTable" },
		{ "class": "DbGateway", "scope": "perProject" },
		{ "class": "DbView", "scope": "perView" }
	],
	"entrypoint": { "assertEnvType": "AssertDbAgentEnv" },
	"erase": { "method": "DELETE", "path": "/internal/projects/:projectId" },
	"bindings": {
		"analyticsEngine": [{ "binding": "DB_EVENTS", "dataset": "cloudflarebase_db_events" }],
		"services": [{ "binding": "AUTH_AGENT", "service": "auth-agent", "optional": true }]
	},
	"secrets": { "generated": [], "optional": [] },
	"vars": {
		"TRUSTED_ORIGINS": { "default": "", "hint": "Extra origins beyond the deployment's own." },
		"SENTRY_DSN": {
			"default": "",
			"hint": "Error reporting; empty disables it. A var, not a secret - a DSN is public by design."
		}
	},
	"routes": [
		{ "path": "/collections/*", "access": "public" },
		{ "path": "/tables/*", "access": "public" },
		{ "path": "/views/*", "access": "public" },
		{ "path": "/realtime", "access": "public" },
		{ "path": "/config", "access": "public" },
		{ "path": "/remote-config", "access": "public" },
		{ "path": "/overview", "access": "operator" },
		{ "path": "/admin/*", "access": "operator" }
	],
	"proxy": { "apiPrefix": "db", "agentBasePath": "" },
	"permissions": ["documents:read", "documents:write", "collections:write"],
	"console": {
		"section": "Database",
		"icon": "database",
		"peek": 3,
		"pages": [
			{ "path": "/db", "title": "Collections", "testId": "nav-db", "icon": "folder-tree" },
			{ "path": "/db/tables", "title": "Tables", "testId": "nav-db-tables", "icon": "table" },
			{
				"path": "/db/sql",
				"title": "SQL Editor",
				"testId": "nav-db-sql",
				"icon": "terminal-square"
			},
			{
				"path": "/db/access",
				"title": "Access",
				"testId": "nav-db-access",
				"icon": "shield-check"
			},
			{
				"path": "/db/replication",
				"title": "Replication",
				"testId": "nav-db-replication",
				"icon": "globe"
			},
			{
				"path": "/db/integration",
				"title": "Integration",
				"testId": "nav-db-integration",
				"icon": "plug"
			},
			{
				"path": "/config",
				"title": "Parameters",
				"testId": "nav-remote-config",
				"icon": "sliders-horizontal",
				"section": "Remote Config"
			},
			{
				"path": "/config/integration",
				"title": "Integration",
				"testId": "nav-config-integration",
				"icon": "plug",
				"section": "Remote Config"
			}
		]
	}
}
