/**
 * Wrangler configuration for a Worker that hosts `@frostbase/db`.
 *
 * Merge this into your own `wrangler.jsonc`, then run `npx wrangler types` so
 * the generated `Env` carries these bindings. The agent reads `Env` from your
 * configuration, not from the package - see `AssertDbAgentEnv` for a
 * compile-time check that you declared everything it needs.
 *
 * The `migrations` block below is a FRESH v1 declaring all FIVE Durable
 * Object classes. Do not copy the tag history from the Frostbase
 * repository. (Upgrading an install that predates DbTable, DbGateway, or
 * DbView? The CLI's merge appends the missing classes under your next free
 * tag automatically.)
 */
{
	"main": "src/index.ts",

	// `nodejs_als` backs the async local storage the Agents SDK uses for
	// request context.
	"compatibility_date": "2026-07-10",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],

	// Five SQLite-backed Durable Object classes: DbAgent is the per-project
	// coordinator; DbCollection holds one collection's documents and live
	// queries; DbTable holds one SQL table's typed rows (drizzle/prisma-
	// compatible storage) - both named `<projectId>:<name>`; DbGateway
	// terminates the one-socket realtime channel near the subscriber; DbView
	// holds a read-only join view, following several tables' change logs into
	// one SQLite so a SELECT can join them.
	// `new_sqlite_classes` is required - the classic key-value backend cannot
	// run the embedded database.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DbAgent", "DbCollection", "DbTable", "DbGateway", "DbView"],
		},
	],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "DbAgent",
				"name": "DbAgent",
			},
			{
				"class_name": "DbCollection",
				"name": "DbCollection",
			},
			{
				"class_name": "DbTable",
				"name": "DbTable",
			},
			{
				"class_name": "DbGateway",
				"name": "DbGateway",
			},
			{
				"class_name": "DbView",
				"name": "DbView",
			},
		],
	},

	// Required. Document and collection events are written here; the dataset
	// auto-creates on first write and writes need no API credentials.
	"analytics_engine_datasets": [
		{
			"binding": "DB_EVENTS",
			"dataset": "cloudflarebase_db_events",
		},
	],

	/**
	 * NOT included: an AUTH_AGENT service binding. If `@frostbase/auth`
	 * lives in this same Worker (the normal `frostbase add auth` setup),
	 * the db agent finds its AuthAgent Durable Object binding automatically
	 * and token-verified collections just work. A service binding is only for
	 * multi-worker deployments where auth runs as a separate Worker:
	 *
	 *   "services": [{ "binding": "AUTH_AGENT", "service": "your-auth-worker" }]
	 *
	 * With neither present, `public` collections work and token-gated ones
	 * fail closed with 503.
	 */

	"vars": {
		/**
		 * CSRF/CORS allowlist for EXTRA origins. Your deployment trusts its own
		 * origin automatically. Add origins (comma separated, no trailing
		 * slash) when another domain calls the API with credentials.
		 */
		"TRUSTED_ORIGINS": "",

		/**
		 * DELIBERATELY ABSENT: "EXPOSE_OPERATOR_API": "true".
		 *
		 * Your collections and tables are served either way, with the access
		 * modes, JWT gate, and validators you configure. This flag is about the
		 * OPERATOR routes - /admin/* and /overview - which authenticate nobody:
		 * /admin/query reads any collection whatever its access mode, and
		 * /admin/.../import and /restore rewrite one. On this Worker, which
		 * serves your application on a public hostname, they answer 404.
		 *
		 * Your own code is unaffected: reach the agent through the DbAgent
		 * Durable Object namespace binding, which no HTTP caller can.
		 *
		 * Set it ONLY on a Worker that has no public hostname of its own
		 * (workers_dev false, no route) and is fronted by something that
		 * authenticates operators.
		 */

		/**
		 * OPTIONAL. Empty disables error reporting, which is the default and a
		 * perfectly good place to stay - nothing else about the agent changes.
		 *
		 * To turn it on, put your DSN on the line below. It belongs here as a
		 * var and not in `wrangler secret put`: a Sentry DSN is public by
		 * design, and this line is uploaded as a plain_text binding of the same
		 * name, so it would override a secret you set under it.
		 */
		"SENTRY_DSN": "",
	},

	// No secret has to be set for this Worker to work.
	"secrets": {
		"required": [],
	},
}
