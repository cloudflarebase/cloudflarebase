/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"migrations": [
		{
			"new_sqlite_classes": ["MyDurableObject"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["AuthAgent"],
			"deleted_classes": ["MyDurableObject"],
			"tag": "v2",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AuthAgent",
				"name": "AuthAgent",
			},
		],
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
		},
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"workers_dev": false,
	"preview_urls": false,
	"ai": {
		"binding": "AI",
	},
	"send_email": [{ "name": "EMAIL" }],

	/**
	 * No secret has to be set for this Worker to work.
	 *
	 * BETTER_AUTH_SECRET is optional: when unset, each project generates its
	 * own signing key on first start and keeps it in its own Durable Object
	 * storage. Set it with `wrangler secret put BETTER_AUTH_SECRET` only if you
	 * want to own and rotate the value yourself - it then applies to every
	 * project on this deployment.
	 *
	 * Also optional: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (social sign-in,
	 * settable per project from the console instead), and CF_ACCOUNT_ID /
	 * CF_ANALYTICS_API_TOKEN (Analytics Engine SQL reads - writes need no
	 * credentials).
	 *
	 * Self-hosted defaults. cloudflarebase.com's own values are in
	 * env.production - the top level must be deployable by someone who does
	 * not own this project's domain or mail sender.
	 *
	 * TRUSTED_ORIGINS is the CSRF allowlist for EXTRA origins. A deployment
	 * trusts its own origin automatically, so sign-in works right after a
	 * fresh deploy with this empty. Add origins here (comma separated, no
	 * trailing slash) only when another domain serves the console or calls
	 * the API with cookies.
	 *
	 * DEMO_MODE is absent on purpose. It makes demo-<hex> projects throwaway -
	 * capped, mail-less, and self-erasing after DEMO_TTL_HOURS - which is only
	 * wanted on a public demo.
	 */
	"vars": {
		"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		// Empty on purpose: a committed DSN would collect every fork's errors.
		// Optional - error reporting is off until you set one, and nothing else
		// changes. Put your own DSN HERE: a DSN is public by design (the web
		// app ships one to the browser), so it is a var, and a
		// `wrangler secret put SENTRY_DSN` would lose to this line on the next
		// deploy - the var is uploaded as a plain_text binding of that name.
		"SENTRY_DSN": "",
		"SENTRY_ENV": "production",
		"TRUSTED_ORIGINS": "",
		// WAE_DATASET is absent with the analytics_engine_datasets block below
		// it names - see the comment there before adding either back.
		/**
		 * Serves the operator plane (/overview, /analytics, /chat, /admin/*,
		 * the state-sync socket, /internal/*) over HTTP. Those routes carry no
		 * authentication of their own: the console guard in front of them is
		 * the gate, and this Worker is only reachable through it - workers_dev
		 * and preview_urls are false and no route is claimed, so the dashboard's
		 * service binding is the sole way in. Every environment below repeats it
		 * for the same reason.
		 *
		 * A Worker that ALSO serves an application (the shape the published
		 * package installs into) must leave this unset - see
		 * template/wrangler-fragment.jsonc.
		 */
		"EXPOSE_OPERATOR_API": "true",
		"EMAIL_FROM": "",
	},

	"secrets": {
		"required": [],
	},

	/**
	 * NO analytics_engine_datasets at the top level, deliberately - this is the
	 * self-hosted default and it has to deploy on a fresh account.
	 *
	 * Analytics Engine is an account-level opt-in that only the Cloudflare
	 * dashboard can grant: no API, no Wrangler flag. Declaring the binding here
	 * made `npm run deploy:all` fail on this very first Worker with
	 * `no_access_to_analytics_engine` (code 10089) for anyone who had never
	 * enabled it - the script upload is refused, so no code ever runs. It also
	 * bought that install nothing, because READING the events needs
	 * CF_ACCOUNT_ID + CF_ANALYTICS_API_TOKEN, which are optional.
	 *
	 * To turn auth analytics on: enable Analytics Engine in the dashboard, then
	 * add both of these back (the dataset auto-creates on first write, and
	 * writes need no credentials):
	 *
	 *   "analytics_engine_datasets": [
	 *     { "binding": "AUTH_EVENTS", "dataset": "cloudflarebase_auth_events" }
	 *   ],
	 *   "vars": { "WAE_DATASET": "cloudflarebase_auth_events" }
	 *
	 * Every environment below is cloudflarebase.com's own and declares it: those
	 * accounts have it enabled.
	 */

	"env": {
		/**
		 * cloudflarebase.com's own agent. The name is pinned rather than derived
		 * so it stays `auth-agent`, which is what the dashboard Worker's
		 * AUTH_AGENT service binding resolves. Wrangler does not inherit
		 * top-level configuration into an environment, so this repeats it.
		 */
		"production": {
			"name": "auth-agent",
			"ai": { "binding": "AI" },
			"send_email": [{ "name": "EMAIL" }],

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				// LAUNCHED 2026-08-13. Public sign-up with required email
				// verification, the same configuration preview rehearses. It took
				// effect the moment this agent deployed, which is safe because the
				// ownership-aware web worker was already live (its OpenAPI serves
				// /branches) - a stranger who registers gets their
				// own personal org and sees nothing else. Mail (the EMAIL binding
				// + EMAIL_FROM below) is what makes "open" effective; without it
				// the agent reports "claimed" and 503s sign-up rather than
				// registering accounts that could never verify.
				// DEMO_MODE stays on: anonymous visitors keep throwaway projects
				// alongside real accounts.
				"CONSOLE_SIGNUPS": "open",
				"DEMO_MODE": "true",
				"DEMO_TTL_HOURS": "720",
				// Committed on purpose: env.production is cloudflarebase.com's own
				// block (forks deploy the top level, whose DSN stays empty).
				"SENTRY_DSN": "https://50ed6e26b886124ac39e983efb72144d@o4510375271530496.ingest.de.sentry.io/4511764380778576",
				"SENTRY_ENV": "production",
				"TRUSTED_ORIGINS": "https://cloudflarebase.com",
				"WAE_DATASET": "cloudflarebase_auth_events",
				"EXPOSE_OPERATOR_API": "true",
				"EMAIL_FROM": "auth@notifications.cloudflarebase.com",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events",
				},
			],

			"workers_dev": false,
			"preview_urls": false,

			"secrets": {
				"required": [],
			},
		},

		"local": {
			"name": "auth-agent-local",
			"ai": {
				"binding": "AI",
				"remote": true,
			},
			// Local mail: wrangler dev intercepts send_email and writes each
			// message as an .eml file (path logged in the agent's terminal),
			// verification links included - which is what lets local dev run
			// the real open-signup flow end to end.
			"send_email": [{ "name": "EMAIL" }],

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				// The launch configuration (open sign-ups + anonymous demos), so
				// the managed flows - registration, verification - are all
				// exercisable on a laptop. env.test stays claimed: the e2e
				// owner-claim setup depends on it.
				"CONSOLE_SIGNUPS": "open",
				// Local sign-up flows straight into a session: the verification
				// mail only lands in wrangler's .eml files, so requiring it would
				// dead-end every local account behind a file hunt. Local-only -
				// deployed opens keep the requirement.
				"DISABLE_EMAIL_VERIFICATION": "true",
				"DEMO_MODE": "true",
				"DEMO_TTL_HOURS": "720",
				"EMAIL_FROM": "auth@example.com",
				"TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8788",
				"WAE_DATASET": "cloudflarebase_auth_events_local",
				"EXPOSE_OPERATOR_API": "true",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events_local",
				},
			],
			"d1_databases": [
				{
					"binding": "LOCAL_ANALYTICS",
					"database_name": "cloudflarebase-auth-analytics-local",
					"database_id": "11111111-1111-4111-8111-111111111111",
				},
			],
		},

		// Isolated environment for Playwright e2e runs (fresh state dir, own
		// dev-registry name so it can coexist with a running `npm run dev`).
		"test": {
			"name": "auth-agent-test",

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				// Pinned so a reused local stack keeps sessions valid across restarts;
				// unset, each project would generate its own. Test-only, worthless
				// elsewhere.
				"BETTER_AUTH_SECRET": "cloudflarebase-e2e-test-secret-at-least-32-chars-long",
				"DISABLE_RATE_LIMIT": "true",
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				// DEMO_MODE is deliberately NOT set on the agent here, while the web
				// Worker does set it. The web flag is what lets anonymous demo
				// traffic past the console guard, which the demo specs need; the
				// agent flag would additionally refuse the console owner claim,
				// which console.setup.ts performs and every operator spec depends
				// on. A real demo deployment sets both.
				"TRUSTED_ORIGINS": "http://localhost:8797,http://127.0.0.1:8797",
				"WAE_DATASET": "cloudflarebase_auth_events_test",
				"EXPOSE_OPERATOR_API": "true",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events_test",
				},
			],
			"d1_databases": [
				{
					"binding": "LOCAL_ANALYTICS",
					"database_name": "cloudflarebase-auth-analytics-test",
					"database_id": "22222222-2222-4222-8222-222222222222",
				},
			],
		},

		"preview": {
			"name": "auth-agent-preview",
			"ai": {
				"binding": "AI",
			},
			"send_email": [{ "name": "EMAIL" }],

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				// Preview IS the launch rehearsal: open sign-ups + demos, the
				// managed configuration. Safe here because the preview web Worker
				// (cloudflarebase-com-preview, deployed by Workers Builds from the
				// preview branch) already carries the ownership guard
				//.
				"CONSOLE_SIGNUPS": "open",
				"DEMO_MODE": "true",
				"DEMO_TTL_HOURS": "720",
				"EMAIL_FROM": "auth@notifications.cloudflarebase.com",
				"SENTRY_DSN": "https://093f7505d223a871223f9a15130ef116@o4510375271530496.ingest.de.sentry.io/4511764377043024",
				"SENTRY_ENV": "preview",
				"TRUSTED_ORIGINS": "https://cloudflarebase-com-preview.cloudflarebase.workers.dev",
				"WAE_DATASET": "cloudflarebase_auth_events_preview",
				"EXPOSE_OPERATOR_API": "true",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events_preview",
				},
			],

			"workers_dev": false,
			"preview_urls": false,

			"secrets": {
				"required": [],
			},
		},
	},
}
