/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"migrations": [
		{
			"new_sqlite_classes": ["MyDurableObject"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["AuthAgent"],
			"deleted_classes": ["MyDurableObject"],
			"tag": "v2",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AuthAgent",
				"name": "AuthAgent",
			},
		],
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
		},
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"workers_dev": false,
	"preview_urls": false,
	"ai": {
		"binding": "AI",
	},
	"send_email": [{ "name": "EMAIL" }],

	/**
	 * No secret has to be set for this Worker to work.
	 *
	 * BETTER_AUTH_SECRET is optional: when unset, each project generates its
	 * own signing key on first start and keeps it in its own Durable Object
	 * storage. Set it with `wrangler secret put BETTER_AUTH_SECRET` only if you
	 * want to own and rotate the value yourself - it then applies to every
	 * project on this deployment.
	 *
	 * Also optional: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (social sign-in,
	 * settable per project from the console instead), and CF_ACCOUNT_ID /
	 * CF_ANALYTICS_API_TOKEN (Analytics Engine SQL reads - writes need no
	 * credentials).
	 *
	 * Self-hosted defaults. cloudflarebase.com's own values are in
	 * env.production - the top level must be deployable by someone who does
	 * not own this project's domain or mail sender.
	 *
	 * TRUSTED_ORIGINS is the CSRF allowlist for EXTRA origins. A deployment
	 * trusts its own origin automatically, so sign-in works right after a
	 * fresh deploy with this empty. Add origins here (comma separated, no
	 * trailing slash) only when another domain serves the console or calls
	 * the API with cookies.
	 *
	 * DEMO_MODE is absent on purpose. It makes demo-<hex> projects throwaway -
	 * capped, mail-less, and self-erasing after DEMO_TTL_HOURS - which is only
	 * wanted on a public demo.
	 */
	"vars": {
		"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		// Empty on purpose: a committed DSN would collect every fork's errors.
		// Set your own with `wrangler secret put SENTRY_DSN` to turn it on.
		"SENTRY_DSN": "",
		"SENTRY_ENV": "production",
		"TRUSTED_ORIGINS": "",
		"WAE_DATASET": "cloudflarebase_auth_events",
		"EMAIL_FROM": "",
	},

	"secrets": {
		"required": [],
	},

	// Metrics pipeline: every auth event writes a data point (event type,
	// country, provider) indexed by project id. Dataset auto-creates on first
	// write; local dev/test writes are no-ops.
	"analytics_engine_datasets": [
		{
			"binding": "AUTH_EVENTS",
			"dataset": "cloudflarebase_auth_events",
		},
	],

	"env": {
		/**
		 * cloudflarebase.com's own agent. The name is pinned rather than derived
		 * so it stays `auth-agent`, which is what the dashboard Worker's
		 * AUTH_AGENT service binding resolves. Wrangler does not inherit
		 * top-level configuration into an environment, so this repeats it.
		 */
		"production": {
			"name": "auth-agent",
			"ai": { "binding": "AI" },
			"send_email": [{ "name": "EMAIL" }],

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				"DEMO_MODE": "true",
				"DEMO_TTL_HOURS": "24",
				"SENTRY_DSN": "",
				"SENTRY_ENV": "production",
				"TRUSTED_ORIGINS": "https://cloudflarebase.com",
				"WAE_DATASET": "cloudflarebase_auth_events",
				"EMAIL_FROM": "auth@notifications.cloudflarebase.com",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events",
				},
			],

			"workers_dev": false,
			"preview_urls": false,

			"secrets": {
				"required": [],
			},
		},

		"local": {
			"name": "auth-agent-local",
			"ai": {
				"binding": "AI",
				"remote": true,
			},

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				"DEMO_MODE": "true",
				"DEMO_TTL_HOURS": "24",
				"TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8788",
				"WAE_DATASET": "cloudflarebase_auth_events_local",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events_local",
				},
			],
			"d1_databases": [
				{
					"binding": "LOCAL_ANALYTICS",
					"database_name": "cloudflarebase-auth-analytics-local",
					"database_id": "11111111-1111-4111-8111-111111111111",
				},
			],
		},

		// Isolated environment for Playwright e2e runs (fresh state dir, own
		// dev-registry name so it can coexist with a running `npm run dev`).
		"test": {
			"name": "auth-agent-test",

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				// Pinned so a reused local stack keeps sessions valid across restarts;
				// unset, each project would generate its own. Test-only, worthless
				// elsewhere.
				"BETTER_AUTH_SECRET": "P6YAEopHeROWj8TE/tlIA7HnPNO8CGsF6bw+5G5UVxsVidsO5pJF8by37OWYEBlE",
				"DISABLE_RATE_LIMIT": "true",
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				// DEMO_MODE is deliberately NOT set on the agent here, while the web
				// Worker does set it. The web flag is what lets anonymous demo
				// traffic past the console guard, which the demo specs need; the
				// agent flag would additionally refuse the console owner claim,
				// which console.setup.ts performs and every operator spec depends
				// on. A real demo deployment sets both.
				"TRUSTED_ORIGINS": "http://localhost:8797,http://127.0.0.1:8797",
				"WAE_DATASET": "cloudflarebase_auth_events_test",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events_test",
				},
			],
			"d1_databases": [
				{
					"binding": "LOCAL_ANALYTICS",
					"database_name": "cloudflarebase-auth-analytics-test",
					"database_id": "22222222-2222-4222-8222-222222222222",
				},
			],
		},

		"preview": {
			"name": "auth-agent-preview",
			"ai": {
				"binding": "AI",
			},
			"send_email": [{ "name": "EMAIL" }],

			"durable_objects": {
				"bindings": [
					{
						"class_name": "AuthAgent",
						"name": "AuthAgent",
					},
				],
			},

			"vars": {
				"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				"DEMO_MODE": "true",
				"DEMO_TTL_HOURS": "24",
				"EMAIL_FROM": "auth@notifications.cloudflarebase.com",
				"SENTRY_DSN": "",
				"SENTRY_ENV": "preview",
				"TRUSTED_ORIGINS": "https://preview.cloudflarebase.com",
				"WAE_DATASET": "cloudflarebase_auth_events_preview",
			},

			"analytics_engine_datasets": [
				{
					"binding": "AUTH_EVENTS",
					"dataset": "cloudflarebase_auth_events_preview",
				},
			],

			"workers_dev": false,
			"preview_urls": false,

			"secrets": {
				"required": [],
			},
		},
	},
}
