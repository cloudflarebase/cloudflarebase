{
	"name": "@cloudflarebase/auth",
	"version": "0.7.4",
	"description": "Better Auth on a Cloudflare Durable Object, one instance per project - the auth primitive behind Cloudflarebase.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudflarebase/cloudflarebase.git",
		"directory": "agents/auth"
	},
	"homepage": "https://github.com/cloudflarebase/cloudflarebase/tree/main/agents/auth#readme",
	"bugs": "https://github.com/cloudflarebase/cloudflarebase/issues",
	"keywords": [
		"cloudflare",
		"workers",
		"durable-objects",
		"better-auth",
		"authentication",
		"agents",
		"cloudflarebase"
	],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./admin": {
			"types": "./dist/admin.d.ts",
			"default": "./dist/admin.js"
		},
		"./wrangler-fragment.jsonc": "./template/wrangler-fragment.jsonc",
		"./cloudflarebase.agent.json": "./cloudflarebase.agent.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"template",
		"NOTICE",
		"cloudflarebase.agent.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --import tsx --test src/route-access.unit.test.ts src/email-callback.unit.test.ts",
		"prepublishOnly": "npm run build",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --env local --persist-to=../../.wrangler/state/ --ip 0.0.0.0 --port 8788",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"dev:test": "wrangler dev --env test --ip 127.0.0.1 --port 8798 --persist-to ../../.wrangler/test-state/auth-agent",
		"deploy:production": "wrangler deploy --env production",
		"migrations": "drizzle-kit generate && node scripts/generate-migrations.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.20.0",
		"typescript": "^5.5.2",
		"wrangler": "^4.110.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.66.0",
		"agents": "^0.17.4",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	}
}
