/**
 * Wrangler configuration for a Worker that hosts `@frostbase/auth`.
 *
 * Merge this into your own `wrangler.jsonc`, then run `npx wrangler types` so
 * the generated `Env` carries these bindings. The agent reads `Env` from your
 * configuration, not from the package - see `AssertAuthAgentEnv` for a
 * compile-time check that you declared everything it needs.
 *
 * The `migrations` block below is a FRESH v1. Do not copy the tag history from
 * the Frostbase repository: that carries a rename of an earlier class and
 * replaying it against a new Worker would try to delete a class you never had.
 */
{
	"main": "src/index.ts",

	// Better Auth needs both. `nodejs_als` backs the async local storage the
	// Agents SDK uses for request context.
	"compatibility_date": "2026-07-10",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],

	// The agent is a SQLite-backed Durable Object: one instance per project,
	// named by project id. `new_sqlite_classes` is required - the classic
	// key-value backend cannot run the embedded database.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AuthAgent"],
		},
	],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "AuthAgent",
				"name": "AuthAgent",
			},
		],
	},

	/**
	 * Optional, and deliberately NOT included: auth-event analytics.
	 *
	 * Analytics Engine is an account-level opt-in that only the Cloudflare
	 * dashboard can grant - no API, no Wrangler flag - and declaring the binding
	 * makes `wrangler deploy` fail with `no_access_to_analytics_engine` (code
	 * 10089) until it is enabled. Shipping it here would break the first deploy
	 * of every install that has not turned it on.
	 *
	 * Enable it in the dashboard, then add:
	 *
	 *   "analytics_engine_datasets": [
	 *     { "binding": "AUTH_EVENTS", "dataset": "cloudflarebase_auth_events" }
	 *   ],
	 *
	 * plus "WAE_DATASET" in vars below, matching that dataset name. The dataset
	 * auto-creates on first write and writes need no API credentials; reading
	 * the events additionally needs CF_ACCOUNT_ID and CF_ANALYTICS_API_TOKEN.
	 * Without any of it the agent runs unchanged and records nothing.
	 */

	// Optional. Powers `POST /chat`, which is the only route that calls it.
	// Without it the rest of the agent is unaffected and /chat returns 502.
	"ai": {
		"binding": "AI",
	},

	// Optional. Verification and password-reset mail. Core sign-up and sign-in
	// work without it.
	"send_email": [{ "name": "EMAIL" }],

	"vars": {
		/**
		 * CSRF allowlist for EXTRA origins. Your deployment trusts its own
		 * origin automatically, so sign-in works with this empty. Add origins
		 * (comma separated, no trailing slash) when another domain serves
		 * your UI or calls the API with cookies.
		 */
		"TRUSTED_ORIGINS": "",

		"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",

		/**
		 * DELIBERATELY ABSENT: "EXPOSE_OPERATOR_API": "true".
		 *
		 * The agent's operator routes - /overview, /analytics, /chat, /admin/*
		 * (users, sessions, roles, settings), the state-sync socket, and
		 * /internal/* - authenticate nobody. They are meant to sit behind a
		 * console that has already checked the caller. On this Worker, which
		 * serves your application on a public hostname, they answer 404 and
		 * only /api/auth/* and /config are served.
		 *
		 * Your own code is unaffected: reach the agent through the AuthAgent
		 * Durable Object namespace binding, which no HTTP caller can.
		 *
		 * Set it ONLY on a Worker that has no public hostname of its own
		 * (workers_dev false, no route) and is fronted by something that
		 * authenticates operators. Setting it here publishes your user table.
		 */

		/**
		 * OPTIONAL. Empty disables error reporting, which is the default and a
		 * perfectly good place to stay - nothing else about the agent changes.
		 *
		 * To turn it on, put your DSN on the line below. It belongs here as a
		 * var and not in `wrangler secret put`: a Sentry DSN is public by
		 * design, and this line is uploaded as a plain_text binding of the same
		 * name, so it would override a secret you set under it.
		 */
		"SENTRY_DSN": "",
	},

	/**
	 * No secret has to be set for this Worker to work.
	 *
	 * BETTER_AUTH_SECRET is optional: when unset, each project generates its own
	 * signing key on first start and keeps it in its own Durable Object storage.
	 * Set it only if you want to own and rotate the value yourself - it then
	 * applies to every project on the deployment.
	 */
	"secrets": {
		"required": [],
	},
}
