{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"jsx": "react-jsx",
		"module": "es2022",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["./worker-configuration.d.ts", "node"]
	},

	/*
	 * `dist` is this project's own build output - with allowJs on it would be
	 * typechecked alongside the sources it was emitted from. `template` holds
	 * files meant to be copied into a consumer's project, so they import
	 * `@frostbase-dev/storage` by package name, which does not resolve from
	 * inside the package itself.
	 */
	"exclude": ["dist", "template", "node_modules"]
}
