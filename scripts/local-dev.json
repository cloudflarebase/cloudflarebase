{
	"prefix": "name",
	"killOthersOn": ["failure"],
	"restartTries": 0,
	"commands": [
		{
			"name": "auth-agent",
			"command": "npm run dev --prefix ./agents/auth"
		},
		{
			"name": "db-agent",
			"command": "npm run dev --prefix ./agents/db"
		},
		{
			"name": "storage-agent",
			"command": "npm run dev --prefix ./agents/storage"
		},
		{
			"name": "web",
			"command": "wait-on tcp:localhost:8788 tcp:localhost:8789 tcp:localhost:8791 && vite dev --port 5173 --open --host"
		}
	]
}
