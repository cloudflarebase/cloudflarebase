{
	"name": "cloudflarebase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.js",
		"demo:video": "node scripts/demo-video.mjs",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "npm run build && wrangler deploy",
		"deploy:all": "npm --prefix agents/auth run deploy && npm run deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"postinstall": "cross-env POSTINSTALL=true node scripts/dev.js",
		"test": "playwright test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"deploy:production": "npm run build && wrangler deploy --env production"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.23.0",
		"@playwright/test": "^1.61.1",
		"@scalar/api-reference": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^22.20.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"flag-icons": "^7.5.0",
		"formsnap": "^2.0.1",
		"globals": "^17.4.0",
		"layerchart": "^2.0.0-next.48",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.3.0",
		"shiki": "^4.3.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.7",
		"wait-on": "^9.0.3",
		"wrangler": "^4.110.0"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.66.0",
		"agents": "^0.17.4",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	}
}
